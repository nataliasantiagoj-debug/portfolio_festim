# ==============================================================================
# FESTIM CULTURAL · MODELO DE VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================
# ATENÇÃO: Nunca suba o arquivo .env com valores reais para o GitHub!
# Este arquivo (.env.example) serve apenas como modelo e documentação.
# Copie este arquivo para .env no seu ambiente local (cp .env.example .env)
# e configure as variáveis no painel da Vercel (Project Settings > Environment Variables).

# --- ACESSO AO PAINEL DE GESTÃO / ADMIN ---
# Senha de acesso para os editores no Painel de Produção
# Escolha uma senha forte com letras, números e símbolos (mínimo 8 caracteres)
VITE_ADMIN_PASSWORD="coloque_uma_senha_forte_aqui"

# E-mails das contas autorizadas a entrar no painel de administração (separados por vírgula)
VITE_ADMIN_EMAILS="seu_email@dominio.com,outro_email@dominio.com"

# --- INFORMAÇÕES DE CONTATO PÚBLICAS ---
# E-mail institucional exibido no site e nos formulários
VITE_CONTACT_EMAIL="contato@festim.art.br"

# WhatsApp / Telefone institucional de atendimento
VITE_CONTACT_PHONE="+55 (71) 99999-9999"

# --- INTEGRAÇÕES E APIS ---
# Chave da API do Google Gemini (se aplicável para recursos de IA no backend)
GEMINI_API_KEY="SUA_CHAVE_GEMINI_AQUI"

# URL pública onde o site está hospedado (ex: https://festim.art.br ou https://seu-app.vercel.app)
APP_URL="https://festim.art.br"
